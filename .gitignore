node_modules
package-lock.json
verifica-*.mjs

# I dati dei giocatori: stanno sul server di chi lo fa girare, non
# nel progetto. Se finissero qui dentro, ogni copia del progetto si
# porterebbe dietro sharkini e collezioni di qualcun altro.
dati/
*.rotto-*

# Le illustrazioni sono file pesanti: stanno fuori dal progetto.
illustrazioni/grezze/*
illustrazioni/pulite/*
!illustrazioni/LEGGIMI.txt

# Prove ed esperimenti sulle cornici delle carte: pesanti e non definitivi.
# Tutto quello che comincia per _ dentro cards/frames e' materiale di
# lavoro (prove, verifiche, ritagli di controllo): la regola sta sul
# trattino basso invece che sui singoli nomi, cosi' vale anche per le
# prove che verranno.
cards/frames/_*

__pycache__/
*.pyc

# Eseguibile di terze parti (tunnel Cloudflare), scaricato a parte: pesante
# e non è codice del progetto.
cloudflared.exe
